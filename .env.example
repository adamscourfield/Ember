DATABASE_URL="postgresql://ember:ember_secret@localhost:5432/ember"
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ── Database connection pool (optional) ───────────────────────────────────────
# Left unset, Prisma uses its default small pool (num_cpus * 2 + 1). Under
# live-session load this becomes the bottleneck. Tune for rollout — see
# docs/SCALING.md for how to size against Postgres max_connections.
# DATABASE_CONNECTION_LIMIT="20"   # max pooled connections per app instance
# DATABASE_POOL_TIMEOUT="10"       # seconds a query waits for a free connection

# ── TypeSafe (Jev) — optional ─────────────────────────────────────────────────
# Structured judgments (choice / score / yes-no) via src/lib/ai/typesafe.ts.
# TYPESAFE_API_KEY=""
