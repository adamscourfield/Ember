generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  LEADERSHIP
}

enum AttemptMode {
  PRACTICE
  DIAGNOSTIC
  REVIEW
}

enum DiagnosticStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum BaselineStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum KnowledgeQuestionType {
  ROUTINE
  FLUENCY
  RETRIEVAL
  TRANSFER
  APPLICATION
  MIXED
  DIAGNOSTIC
}

enum SupportLevel {
  INDEPENDENT
  LIGHT_PROMPT
  WORKED_EXAMPLE
  SCAFFOLDED
  FULL_EXPLANATION
}

enum QuestionContextType {
  ROUTINE
  MIXED
  TRANSFER
}

enum DelayBucket {
  IMMEDIATE
  SAME_DAY
  D1
  D3
  D7_PLUS
}

enum DurabilityBand {
  AT_RISK
  DEVELOPING
  DURABLE
}

enum LiveSessionStatus {
  LOBBY
  ACTIVE
  PAUSED
  COMPLETED
}

enum LessonBlockType {
  DO_NOW
  EXPLAIN
  MODEL
  CHECK
  PRACTICE
}

enum LessonItemType {
  SLIDE
  QUESTION
  IMAGE
  CANVAS_FRAME
}

enum AnswerMode {
  MCQ
  ORDER
  SHORT_ANSWER
  PICK
}

enum LiveSessionPhase {
  DIAGNOSTIC
  EXPLANATION
  SHADOW_CHECK
  REVIEW
}

enum TimetableSlotRecurrence {
  WEEKLY
  BIWEEKLY
  MONTHLY_NTH
}

enum StudentLane {
  LANE_1
  LANE_2
  LANE_3
}

enum EscalationReason {
  SHADOW_CHECK_FAILED
  ANCHOR_FAILED
  MISCONCEPTION_FAILED
  SCAFFOLDED_CORRECT
  MANUAL_TEACHER
  HINTS_USED
  // A student coping at the diagnostic who then fails a run of live practice
  // questions on the active skill — lane re-evaluated downward mid-lesson.
  PRACTICE_REGRESSION
}

enum LaneTransitionType {
  ASSIGNED
  ESCALATED
  HANDED_BACK
  RESOLVED
}

enum ItemReviewStatus {
  OPEN
  RESOLVED
}

enum ItemReviewCategory {
  ANSWER_MODE
  ANSWER_MAPPING
  STEM_COPY
  DISTRACTOR_QUALITY
  SKILL_MAPPING
  OTHER
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  password           String
  name               String?
  role               Role                    @default(STUDENT)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  attempts           Attempt[]
  baselineAttempts   BaselineAttempt[]
  skillMasteries     SkillMastery[]
  events             Event[]
  diagnosticSessions DiagnosticSession[]
  baselineSessions   BaselineSession[]
  interventionFlags  InterventionFlag[]
  teacherProfile     TeacherProfile?
  studentProfile     StudentProfile?
  classEnrollments       ClassroomEnrollment[]
  rewardBalance          StudentRewardBalance?
  rewardTransactions     RewardTransaction[]
  guessingSafeguard      GuessingSafeguardState?
  knowledgeSkillStates   StudentSkillState[]
  knowledgeQuestionAttempts QuestionAttempt[]
  knowledgeSkillReviews  SkillReview[]
  itemReviewNotes        ItemReviewNote[]       @relation("ItemReviewAuthor")
  teacherLiveSessions    LiveSession[]          @relation("TeacherLiveSessions")
  liveParticipants       LiveParticipant[]
  liveAttempts           LiveAttempt[]
  curriculumPlans        CurriculumPlan[]
  lessons                Lesson[]
  lessonRecordings       LessonRecording[]
}

model Subject {
  id                 String              @id @default(cuid())
  title              String
  slug               String              @unique
  description        String?
  createdAt          DateTime            @default(now())
  skills             Skill[]
  items              Item[]
  events             Event[]
  diagnosticSessions DiagnosticSession[]
  baselineSessions   BaselineSession[]
  interventionFlags  InterventionFlag[]
  rewardTransactions RewardTransaction[]
  liveSessions       LiveSession[]
  curriculumPlans    CurriculumPlan[]
  lessons            Lesson[]
}

model Skill {
  id                String             @id @default(cuid())
  code              String
  name              String
  slug              String
  strand            String             @default("")
  isStretch         Boolean            @default(false)
  sortOrder         Int                @default(0)
  description       String?
  intro             String?
  subjectId         String
  createdAt         DateTime           @default(now())

  // ── AI generation enrichment ──────────────────────────────────────────────
  // A precise description of what mastery of this skill looks like.
  // Used in generation prompts and verification calls.
  masteryDefinition    String?

  // Structured misconception taxonomy. Array of MisconceptionEntry:
  // { id: string, label: string, description: string, frequency: "HIGH"|"MEDIUM"|"LOW" }
  // The id is the shared key between generation (distractor tagging) and
  // LiveAttempt.misconceptionId (teacher signal).
  misconceptions       Json?

  // What makes questions on this skill easier or harder.
  // Array of { dimension: string, easy: string, hard: string }
  difficultyDimensions Json?

  // Real-world or cross-topic contexts suitable for transfer questions.
  // Array of { context: string, example: string }
  transferContexts     Json?

  // Rich prose context passed directly into the generation system prompt.
  // Everything a good maths teacher would know before writing questions on this topic.
  generativeContext    String?
  subject           Subject            @relation(fields: [subjectId], references: [id])
  prerequisites     SkillPrereq[]      @relation("SkillToPrereq")
  dependents        SkillPrereq[]      @relation("PrereqToSkill")
  items             ItemSkill[]
  masteries         SkillMastery[]
  events            Event[]
  baselineAttempts         BaselineAttempt[]
  interventionFlags        InterventionFlag[]
  explanationRoutes        ExplanationRoute[]
  knowledgeSkillStates     StudentSkillState[]
  knowledgeQuestionAttempts QuestionAttempt[]
  knowledgeSkillReviews    SkillReview[]
  explanationPerformance   ExplanationPerformance[]
  liveSessions             LiveSession[]
  liveAttempts             LiveAttempt[]
  englishContentBlocks     EnglishContentBlock[]
  curriculumUnitSkills     CurriculumUnitSkill[]
  lessonItems              LessonItem[]

  @@unique([subjectId, slug])
  @@unique([subjectId, code])
}

model SkillPrereq {
  skillId  String
  prereqId String
  weight   Int    @default(1)
  skill    Skill  @relation("SkillToPrereq", fields: [skillId], references: [id])
  prereq   Skill  @relation("PrereqToSkill", fields: [prereqId], references: [id])

  @@id([skillId, prereqId])
}

model Item {
  id               String            @id @default(cuid())
  question         String
  type             String            @default("MCQ")
  options          Json
  answer           String
  misconceptionMap Json?
  liveMetadata     Json?
  subjectId        String?
  createdAt        DateTime          @default(now())
  subject          Subject?          @relation(fields: [subjectId], references: [id])
  skills           ItemSkill[]
  attempts                  Attempt[]
  baselineAttempts          BaselineAttempt[]
  events                    Event[]
  knowledgeQuestionAttempts QuestionAttempt[]
  reviewNotes               ItemReviewNote[]
  liveAttempts              LiveAttempt[]
  lessonItems               LessonItem[]
}

model ItemReviewNote {
  id           String             @id @default(cuid())
  itemId        String
  authorUserId  String
  status        ItemReviewStatus  @default(OPEN)
  category      ItemReviewCategory
  note          String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  resolvedAt    DateTime?
  item          Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author        User              @relation("ItemReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([itemId, status, createdAt])
  @@index([authorUserId, createdAt])
}

model ItemSkill {
  itemId  String
  skillId String
  item    Item   @relation(fields: [itemId], references: [id])
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@id([itemId, skillId])
}

model Attempt {
  id                String             @id @default(cuid())
  userId            String
  itemId            String
  answer            String
  correct           Boolean
  sessionId         String?
  mode              AttemptMode        @default(PRACTICE)
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  events            Event[]
  diagnosticSession DiagnosticSession? @relation("DiagnosticAttempts", fields: [sessionId], references: [id])
}

model SkillMastery {
  id                   String    @id @default(cuid())
  userId               String
  skillId              String
  mastery              Float     @default(0)
  streak               Int       @default(0)
  confirmedCount       Int       @default(0)
  lastPracticedAt      DateTime?
  nextReviewAt         DateTime?
  lastReviewedAt       DateTime?
  attemptsSinceConfirm Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id])
  skill                Skill     @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
}

model StudentSkillState {
  id                      String         @id @default(cuid())
  userId                  String
  skillId                 String
  masteryProbability      Float          @default(0.35)
  forgettingRate          Float          @default(0.12)
  halfLifeDays            Float          @default(5.776226504666211)
  retrievalStrength       Float          @default(0.3)
  transferAbility         Float          @default(0.2)
  confidence              Float          @default(0.1)
  latestDle               Float?
  latestLearningGain      Float?
  latestKnowledgeStability Float?
  latestInstructionalTimeMs Int?
  durabilityBand          DurabilityBand @default(AT_RISK)
  lastAttemptAt           DateTime?
  lastSuccessAt           DateTime?
  lastReviewAt            DateTime?
  evidenceCount           Int            @default(0)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill                   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
}

model QuestionAttempt {
  id                 String                @id @default(cuid())
  userId             String
  skillId            String
  itemId             String
  occurredAt         DateTime              @default(now())
  correct            Boolean
  responseTimeMs     Int
  hintsUsed          Int                   @default(0)
  explanationId      String?
  attemptNumber      Int                   @default(1)
  questionDifficulty Float                 @default(0.5)
  questionType       KnowledgeQuestionType @default(ROUTINE)
  contextType        QuestionContextType   @default(ROUTINE)
  delayBucket        DelayBucket           @default(IMMEDIATE)
  instructionalTimeMs Int                  @default(0)
  isTransferItem     Boolean               @default(false)
  isMixedItem        Boolean               @default(false)
  isReviewItem       Boolean               @default(false)
  supportLevel       SupportLevel          @default(INDEPENDENT)
  createdAt          DateTime              @default(now())
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill              Skill                 @relation(fields: [skillId], references: [id], onDelete: Cascade)
  item               Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, skillId, occurredAt])
  @@index([skillId, occurredAt])
}

model SkillReview {
  id                    String    @id @default(cuid())
  userId                String
  skillId               String
  scheduledFor          DateTime
  completedAt           DateTime?
  successScore          Float?
  daysSinceLastExposure Float?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill                 Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
  @@index([userId, skillId, scheduledFor])
}

model ExplanationPerformance {
  id                     String           @id @default(cuid())
  explanationId          String
  skillId                String
  studentSegment         String           @default("default")
  averageLearningGain    Float            @default(0)
  averageHalfLifeDays    Float            @default(0)
  averageInstructionTime Float            @default(0)
  dle                    Float            @default(0)
  evidenceCount          Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  explanation            ExplanationRoute @relation(fields: [explanationId], references: [id], onDelete: Cascade)
  skill                  Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([explanationId, studentSegment])
  @@index([skillId, studentSegment])
}

model StudentRewardBalance {
  id         String   @id @default(cuid())
  userId     String   @unique
  xpTotal    Int      @default(0)
  tokenTotal Int      @default(0)
  streakDays Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RewardTransaction {
  id             String   @id @default(cuid())
  userId         String
  subjectId      String?
  eventName      String
  xpDelta        Int
  tokenDelta     Int
  reason         String
  idempotencyKey String?  @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventName, createdAt])
}

model GuessingSafeguardState {
  id               String    @id @default(cuid())
  userId           String    @unique
  rapidWrongStreak Int       @default(0)
  lastWrongAt      DateTime?
  penaltyRemaining Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id            String   @id @default(cuid())
  name          String
  actorUserId   String?
  studentUserId String?
  subjectId     String?
  skillId       String?
  itemId        String?
  attemptId     String?
  payload       Json
  createdAt     DateTime @default(now())
  actor         User?    @relation(fields: [actorUserId], references: [id])
  subject       Subject? @relation(fields: [subjectId], references: [id])
  skill         Skill?   @relation(fields: [skillId], references: [id])
  item          Item?    @relation(fields: [itemId], references: [id])
  attempt       Attempt? @relation(fields: [attemptId], references: [id])
}

model ExplanationRoute {
  id                   String            @id @default(cuid())
  skillId              String
  routeType            String
  misconceptionSummary String
  workedExample        String
  guidedPrompt         String
  guidedAnswer         String
  isActive             Boolean           @default(true)
  defaultPriorityRank  Int               @default(0)
  animationSchema      Json?
  animationVersion     String?
  animationGeneratedAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  skill                  Skill                     @relation(fields: [skillId], references: [id])
  steps                  ExplanationStep[]
  explanationPerformance ExplanationPerformance[]

  @@unique([skillId, routeType])
}

model ExplanationStep {
  id                 String            @id @default(cuid())
  explanationRouteId String
  stepOrder          Int
  title              String
  explanation        String
  stepType           String            @default("checkpoint")
  checkpointQuestion String
  checkpointOptions  Json
  checkpointAnswer   String
  alternativeHint    String?
  subtopicCode       String?
  questionType       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  route              ExplanationRoute  @relation(fields: [explanationRouteId], references: [id], onDelete: Cascade)
  interactions       StepInteraction[]

  @@unique([explanationRouteId, stepOrder])
}

model InteractionType {
  id          String            @id @default(cuid())
  key         String
  version     String
  schema      Json?
  rendererKey String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  steps       StepInteraction[]

  @@unique([key, version])
}

model StepInteraction {
  id                String          @id @default(cuid())
  explanationStepId String
  interactionTypeId String
  sortOrder         Int             @default(1)
  config            Json
  completionRule    Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  step              ExplanationStep @relation(fields: [explanationStepId], references: [id], onDelete: Cascade)
  interactionType   InteractionType @relation(fields: [interactionTypeId], references: [id])

  @@unique([explanationStepId, sortOrder])
}

model DiagnosticSession {
  id               String           @id @default(cuid())
  userId           String
  subjectId        String
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  status           DiagnosticStatus @default(IN_PROGRESS)
  maxItems         Int              @default(25)
  minItems         Int              @default(12)
  confidenceTarget Float            @default(0.85)
  itemsSeen        Int              @default(0)
  payload          Json             @default("{}")
  user             User             @relation(fields: [userId], references: [id])
  subject          Subject          @relation(fields: [subjectId], references: [id])
  attempts         Attempt[]        @relation("DiagnosticAttempts")
}

model BaselineSession {
  id          String            @id @default(cuid())
  userId      String
  subjectId   String
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  status      BaselineStatus    @default(IN_PROGRESS)
  itemsSeen   Int               @default(0)
  maxItems    Int               @default(24)
  payload     Json              @default("{}")
  user        User              @relation(fields: [userId], references: [id])
  subject     Subject           @relation(fields: [subjectId], references: [id])
  attempts    BaselineAttempt[]

  @@index([userId, subjectId, status])
}

model BaselineAttempt {
  id                String          @id @default(cuid())
  baselineSessionId String
  userId            String
  itemId            String
  skillId           String
  answer            String
  correct           Boolean
  createdAt         DateTime        @default(now())
  baselineSession   BaselineSession @relation(fields: [baselineSessionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id])
  item              Item            @relation(fields: [itemId], references: [id])
  skill             Skill           @relation(fields: [skillId], references: [id])

  @@unique([baselineSessionId, itemId])
  @@index([baselineSessionId, skillId])
}

model InterventionFlag {
  id         String    @id @default(cuid())
  userId     String
  subjectId  String
  skillId    String
  reason     String
  isResolved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id])
  subject    Subject   @relation(fields: [subjectId], references: [id])
  skill      Skill     @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
}

model TeacherProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  externalSource    String             @default("ember_observe")
  externalTeacherId String
  externalSchoolId  String?
  displayName       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  classrooms        TeacherClassroom[]

  @@unique([externalSource, externalTeacherId])
}

model StudentProfile {
  id                String                @id @default(cuid())
  userId            String                @unique
  externalSource    String                @default("ember_observe")
  externalStudentId String
  externalSchoolId  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments       ClassroomEnrollment[]

  @@unique([externalSource, externalStudentId])
}

model Classroom {
  id               String                @id @default(cuid())
  externalSource   String                @default("ember_observe")
  externalClassId  String
  externalSchoolId String?
  name             String
  yearGroup        String?
  subjectSlug      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  teachers         TeacherClassroom[]
  enrollments      ClassroomEnrollment[]
  liveSessions     LiveSession[]
  timetableSlots   ClassroomTimetableSlot[]
  seatingPlan      SeatingPlan?

  @@unique([externalSource, externalClassId])
}

/// A physical seating layout for a classroom. One plan per classroom, reused
/// across live sessions. `seats` is a JSON array of { studentUserId, row, col }.
model SeatingPlan {
  id          String    @id @default(cuid())
  classroomId String    @unique
  rows        Int       @default(5)
  cols        Int       @default(6)
  seats       Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
}

/// Recurring school-style timetable entry (wall-clock in `timezone`).
model ClassroomTimetableSlot {
  id                String                   @id @default(cuid())
  classroomId       String
  label             String?
  room              String?
  /// 0 = Monday … 6 = Sunday
  dayOfWeek         Int
  /// Minutes from midnight (0–1439) in `timezone`
  minuteOfDay       Int
  durationMinutes   Int                      @default(60)
  recurrence        TimetableSlotRecurrence  @default(WEEKLY)
  /// Anchor Monday (any date in that week) for BIWEEKLY; ignored otherwise
  week0Anchor       DateTime?
  /// 1–4 = Nth weekday of month, 5 = last matching weekday
  nthWeekOfMonth    Int?
  timezone          String                   @default("Europe/London")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  classroom         Classroom                @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId])
}

model TeacherClassroom {
  id               String         @id @default(cuid())
  teacherProfileId String
  classroomId      String
  roleLabel        String?
  createdAt        DateTime       @default(now())
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classroom        Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, classroomId])
}

model ClassroomEnrollment {
  id               String          @id @default(cuid())
  classroomId      String
  studentUserId    String
  studentProfileId String?
  createdAt        DateTime        @default(now())
  classroom        Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student          User            @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)

  @@unique([classroomId, studentUserId])
}

model LiveSession {
  id                String            @id @default(cuid())
  classroomId       String
  teacherUserId     String
  subjectId         String
  skillId           String?
  // Link to the Lesson template this session was launched from (nullable for legacy sessions)
  lessonId          String?
  status            LiveSessionStatus @default(LOBBY)
  phase             LiveSessionPhase  @default(DIAGNOSTIC)
  reteachAlert      Boolean           @default(false)
  joinCode          String            @unique
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  // Lesson phase plan: ordered array of {skillId, type, label, explanationRouteId?}
  phases            Json?
  currentPhaseIndex Int               @default(0)
  // What's currently deployed to student devices
  currentContent    Json?
  // Teacher-authored opening checks: { shared?: { skillId, itemId }[], perStudent?: Record<userId, { skillId, itemId }[]> }
  checkPlan         Json?

  classroom     Classroom         @relation(fields: [classroomId], references: [id])
  teacher       User              @relation("TeacherLiveSessions", fields: [teacherUserId], references: [id])
  subject       Subject           @relation(fields: [subjectId], references: [id])
  skill         Skill?            @relation(fields: [skillId], references: [id])
  lesson        Lesson?           @relation(fields: [lessonId], references: [id])
  participants  LiveParticipant[]
  liveAttempts  LiveAttempt[]
  transitions   LaneTransition[]
}

model LiveParticipant {
  id                    String            @id @default(cuid())
  liveSessionId         String
  studentUserId         String
  currentLane           StudentLane       @default(LANE_3)
  currentExplanationId  String?
  pendingRecheckItemId  String?
  escalationReason      EscalationReason?
  isUnexpectedFailure   Boolean           @default(false)
  holdingAtFinalCheck   Boolean           @default(false)
  joinedAt              DateTime          @default(now())
  isActive              Boolean           @default(true)
  lastActiveAt          DateTime          @default(now())
  laneAssignedAt        DateTime?
  // Resolved opening checks: [{ itemId, skillId }, …]; index is the current prompt (session ACTIVE).
  openingCheckQueue     Json?
  openingCheckIndex     Int               @default(0)

  session               LiveSession       @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  student               User              @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  transitions           LaneTransition[]

  @@unique([liveSessionId, studentUserId])
  @@index([liveSessionId, currentLane])
}

model LiveAttempt {
  id            String      @id @default(cuid())
  liveSessionId String
  studentUserId String
  itemId        String
  skillId       String
  answer        String
  correct       Boolean
  responseTimeMs Int
  // Full structured marking output for rubric/open-response items.
  // When present, downstream consumers should prefer this over the binary correct flag.
  markingResult Json?
  // References misconceptions[].id on the Skill node — set when the student
  // selects a distractor that was tagged to a specific misconception at generation time.
  misconceptionId String?
  // Student's self-reported confidence at time of practice submission: 'low' | 'mid' | 'high'
  confidence    String?
  createdAt     DateTime    @default(now())

  session       LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  student       User        @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  item          Item        @relation(fields: [itemId], references: [id])
  skill         Skill       @relation(fields: [skillId], references: [id])

  @@index([liveSessionId, skillId])
  @@index([liveSessionId, studentUserId])
}

model LaneTransition {
  id              String             @id @default(cuid())
  liveSessionId   String
  participantId   String
  studentUserId   String
  fromLane        StudentLane?
  toLane          StudentLane
  transitionType  LaneTransitionType
  reason          EscalationReason?
  triggeredBy     String?
  createdAt       DateTime           @default(now())

  session         LiveSession        @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  participant     LiveParticipant    @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([liveSessionId, createdAt])
}

// ── English content models ─────────────────────────────────────────────────────

model EnglishContentBlock {
  id          String   @id @default(cuid())
  skillId     String
  blockType   String   // TEXT | IMAGE | MODEL | QUESTION | CALLOUT | ANIMATION | SCAFFOLD | CHECKPOINT
  sortOrder   Int
  content     Json     // serialised ExplanationBlock payload
  sourceRef   String?  // e.g. "Y7_HT1_BOOKLET_p12_block3"
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  annotations AnnotationLayer[]

  @@index([skillId, sortOrder])
  @@index([skillId, isPublished])
}

model AIMarkResult {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  mode       AttemptMode
  answer     String      // text answer or "[canvas]" when image-based
  markResult Json        // { correct, score, feedback, wtm, ebi, flagged, latencyMs }
  modelUsed  String
  latencyMs  Int
  createdAt  DateTime    @default(now())

  @@index([attemptId])
  @@index([questionId, createdAt])
}

model AnnotationLayer {
  id        String              @id @default(cuid())
  blockId   String
  strokes   Json                // Stroke[] serialised
  version   Int                 @default(1)
  createdAt DateTime            @default(now())
  block     EnglishContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
}

// ── Curriculum mapper ──────────────────────────────────────────────────────────

model CurriculumPlan {
  id            String           @id @default(cuid())
  title         String
  subjectId     String
  teacherUserId String
  academicYear  String?
  termLabel     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  subject       Subject          @relation(fields: [subjectId], references: [id])
  teacher       User             @relation(fields: [teacherUserId], references: [id])
  units         CurriculumUnit[]

  @@index([teacherUserId])
}

model CurriculumUnit {
  id              String               @id @default(cuid())
  planId          String
  title           String
  aims            String?
  successMeasures String?
  dateStart       DateTime?
  dateEnd         DateTime?
  sortOrder       Int                  @default(0)
  aiReviewNotes   Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  plan            CurriculumPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  skills          CurriculumUnitSkill[]
  lessons         Lesson[]

  @@index([planId, sortOrder])
}

model CurriculumUnitSkill {
  unitId  String
  skillId String
  unit    CurriculumUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([unitId, skillId])
}

// ── Lesson builder ─────────────────────────────────────────────────────────────

model Lesson {
  id                        String          @id @default(cuid())
  title                     String
  topic                     String
  yearGroup                 String?
  teacherUserId             String
  subjectId                 String
  curriculumUnitId          String?
  // True once teacher has dismissed the "add to curriculum map?" prompt
  curriculumPromptDismissed Boolean         @default(false)
  isPublished               Boolean         @default(false)
  // Provenance for copies
  isCopy                    Boolean         @default(false)
  sourceId                  String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  teacher        User            @relation(fields: [teacherUserId], references: [id])
  subject        Subject         @relation(fields: [subjectId], references: [id])
  curriculumUnit CurriculumUnit? @relation(fields: [curriculumUnitId], references: [id])
  source         Lesson?         @relation("LessonCopies", fields: [sourceId], references: [id])
  copies         Lesson[]        @relation("LessonCopies")
  blocks         LessonBlock[]
  liveSessions   LiveSession[]

  @@index([teacherUserId])
  @@index([subjectId])
}

model LessonBlock {
  id        String          @id @default(cuid())
  lessonId  String
  type      LessonBlockType
  sortOrder Int             @default(0)
  title     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  lesson    Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  items     LessonItem[]

  @@index([lessonId, sortOrder])
}

model LessonItem {
  id           String         @id @default(cuid())
  blockId      String
  sortOrder    Int            @default(0)
  itemType     LessonItemType
  // Required when itemType = QUESTION, null otherwise
  answerMode   AnswerMode?
  // Content shape varies by itemType:
  //   SLIDE:         { text, imageUrl?, notes? }
  //   QUESTION:      { stem, options?, answer, misconceptionMap? }
  //   IMAGE:         { url, caption? }
  //   CANVAS_FRAME:  { prompt, backgroundUrl? }
  content      Json
  // Optional link to skill for DLE tracking
  skillId      String?
  // Optional link to Item bank if sourced from question bank
  sourceItemId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  block      LessonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  skill      Skill?      @relation(fields: [skillId], references: [id])
  sourceItem Item?       @relation(fields: [sourceItemId], references: [id])

  @@index([blockId, sortOrder])
}

// ── Lesson feedback (prototype) ─────────────────────────────────────────────
// A teacher records a lesson; audio arrives in ordered chunks while it runs,
// is transcribed with speaker labels, then analysed against the school's
// teacher-talk framework (src/lib/lessonFeedback/framework.ts).

enum LessonRecordingStatus {
  RECORDING
  TRANSCRIBING
  ANALYSING
  READY
  FAILED
}

model LessonRecording {
  id              String                @id @default(cuid())
  teacherUserId   String
  title           String
  status          LessonRecordingStatus @default(RECORDING)
  mimeType        String?
  startedAt       DateTime              @default(now())
  endedAt         DateTime?
  // AssemblyAI transcript id while TRANSCRIBING
  transcriptJobId String?
  // { durationSec, teacherSpeaker, utterances: [{ speaker, isTeacher, startMs, endMs, text }] }
  transcript      Json?
  // Timing metrics computed in code (talk ratio, silences, questions)
  metrics         Json?
  // Framework feedback generated by Claude
  feedback        Json?
  error           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  teacher User                   @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  chunks  LessonRecordingChunk[]

  @@index([teacherUserId, createdAt])
}

model LessonRecordingChunk {
  id          String   @id @default(cuid())
  recordingId String
  seq         Int
  data        Bytes
  createdAt   DateTime @default(now())

  recording LessonRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, seq])
}
