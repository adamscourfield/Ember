{
  "name": "ember",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts && ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-n11-n13.ts && ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-n14-n15.ts",
    "db:import:phase1-unit1": "echo 'DEPRECATED: use npm run db:import:question-bank instead — all files are now in docs/unit-mapping/question-bank/' && exit 1",
    "db:backfill:unit1-visuals": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/backfill-unit1-visuals.ts",
    "db:ensure:routes:n14-n15": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-n14-n15.ts",
    "db:ensure:routes:n5": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-n5.ts",
    "db:ensure:routes:s1": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-s1.ts",
    "db:ensure:routes:a1": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-a1.ts",
    "db:ensure:routes:g1": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-g1.ts",
    "db:ensure:routes:n6": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-n6.ts",
    "db:ensure:routes:n11-n13": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-n11-n13.ts",
    "db:ensure:routes:n4": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-n4-1-to-n4-3.ts",
    "db:ensure:routes:gaps": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-gaps.ts",
    "db:extract:explanations": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/extract-explanations-from-pptx.ts",
    "db:normalize:step-question-types": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/normalize-explanation-step-question-types.ts",
    "db:normalize:item-routing-purpose": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/normalize-item-routing-purpose.ts",
    "db:backfill:live-item-metadata": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/backfill-live-item-metadata.ts",
    "validate:learning": "node scripts/validate-learning-config.mjs",
    "validate:items": "node scripts/validate-item-answer-types.mjs",
    "audit:question-bank:answer-modes": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' scripts/audit-question-bank-answer-modes.ts",
    "validate:explanation-steps": "node scripts/validate-explanations.mjs",
    "validate:n13": "node scripts/validate-n13-content-integrity.mjs",
    "validate:explanations": "node scripts/validate-explanation-integrity.mjs",
    "english:parse-booklet": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' scripts/parseBooklet.ts",
    "qa:resolve:auto-repair-notes": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' scripts/qa/resolve-auto-repair-notes.ts",
    "qa:audit:unit1-visuals": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' scripts/qa/audit-unit1-visuals.ts",
    "validate:qa": "npm run validate:items && npm run validate:n13 && npm run validate:explanation-steps && npm run validate:explanations && npm test",
    "content:extract:unit1": "node scripts/extract-curriculum-pptx.mjs",
    "content:extract:slide-media": "node scripts/extract-curriculum-slide-media.mjs",
    "content:report:unit1-gaps": "node scripts/report-curriculum-seeding-gaps.mjs",
    "content:build:unit1-packs": "node scripts/build-curriculum-review-packs.mjs",
    "content:build:phase1-queue": "node scripts/build-phase1-authoring-queue.mjs",
    "content:build:phase1-briefs": "node scripts/build-phase1-author-briefs.mjs",
    "content:extract:question-bank": "node scripts/extract-pptx-questions.mjs",
    "db:import:question-bank": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/import-question-bank.ts",
    "loadtest:seed": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' scripts/loadtest/seed-loadtest.ts",
    "loadtest:run": "node scripts/loadtest/run-loadtest.mjs"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts && ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-n11-n13.ts && ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' prisma/ensure-routes-n14-n15.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.13",
    "pdf-parse": "^2.4.5",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "jsdom": "^24.0.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^1.6.1"
  }
}
